# Routes
# This file defines all application routes (Higher priority routes first)

# Home page - serves the Backbone.js application
GET     /                           controllers.HomeController.index()

# Database Console
GET     /db/console                 controllers.DbConsoleController.console()
POST    /db/query                   controllers.DbConsoleController.query(request: play.mvc.Http.Request)

# Task API endpoints
GET     /api/tasks                  controllers.TaskController.getTasks()
GET     /api/tasks/:id              controllers.TaskController.getTask(id: Long)
POST    /api/tasks                  controllers.TaskController.createTask(request: play.mvc.Http.Request)
PUT     /api/tasks/:id              controllers.TaskController.updateTask(request: play.mvc.Http.Request, id: Long)
PATCH   /api/tasks/:id              controllers.TaskController.updateTask(request: play.mvc.Http.Request, id: Long)
DELETE  /api/tasks/:id              controllers.TaskController.deleteTask(id: Long)

# Static assets
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
